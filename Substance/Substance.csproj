<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <BuildTarget Condition="'$(BuildTarget)' == '' AND '$(OS)' == 'Windows_NT'">Windows</BuildTarget>
    <BuildTarget Condition="'$(BuildTarget)' == '' AND '$(OS)' == 'Unix'">Linux</BuildTarget>
    <BuildTarget Condition="'$(BuildTarget)' == ''">Windows</BuildTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildTarget)' == 'Windows'">
    <DefineConstants>WINDOWS;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildTarget)' == 'Linux'">
    <DefineConstants>LINUX;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildTarget)' == 'Android'">
    <DefineConstants>ANDROID;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260205-174352" />
    <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
    <PackageReference Condition="'$(BuildTarget)' != 'Android'" Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Condition="'$(BuildTarget)' == 'Android'" Include="Silk.NET.OpenGLES" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

</Project>
