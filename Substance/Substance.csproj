<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <BuildTarget Condition="'$(BuildTarget)' == '' AND '$(OS)' == 'Windows_NT'">Windows</BuildTarget>
    <BuildTarget Condition="'$(BuildTarget)' == '' AND '$(OS)' == 'Unix'">Linux</BuildTarget>
    <BuildTarget Condition="'$(BuildTarget)' == ''">Windows</BuildTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildTarget)' == 'Windows'">
    <DefineConstants>WINDOWS;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildTarget)' == 'Linux'">
    <DefineConstants>LINUX;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildTarget)' == 'Android'">
    <DefineConstants>ANDROID;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="SDL3-CS" Version="3.4.14" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*">
      <LogicalName>Substance/Assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
